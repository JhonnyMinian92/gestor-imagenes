# .env.example — Security Image
#
# Este proyecto NO usa un framework ni una librería de carga de .env (no hay
# composer.json ni vendor/). config.php lee estas variables directamente del
# entorno del proceso vía getenv(). Este archivo es documentación de qué
# variables soporta y con qué valores por defecto, NO un cargador automático.
#
# Cómo definirlas de verdad, según cómo despliegues la app:
#   - Apache + mod_php:        SetEnv NOMBRE valor   (en el VirtualHost, no en .htaccess)
#   - Apache + PHP-FPM:        env[NOMBRE] = valor   (en el pool www.conf) + PassEnv/SetEnv en Apache
#   - systemd:                 Environment="NOMBRE=valor"  (en el .service, o EnvironmentFile=)
#   - Docker / docker-compose: environment: / env_file:
#   - Desarrollo local (CLI):  export NOMBRE=valor   (antes de arrancar `php -S`)
#
# Ninguna de estas variables es obligatoria: si se omiten, la app usa los
# valores por defecto seguros que ya trae config.php.

# --- Entorno ---
# 'development' o 'production'. En 'production', FORCE_HTTPS se activa
# automáticamente (ver config.php y APP_FORCE_HTTPS más abajo).
APP_ENV=production

# --- Forzar HTTPS (H1) ---
# Por defecto se deriva de APP_ENV ('production' => true). Definir esta
# variable solo si un despliegue concreto necesita salirse de esa regla
# (por ejemplo, producción detrás de un proxy que aún no está en
# APP_TRUSTED_PROXIES). Valores aceptados: 1/0, true/false.
APP_FORCE_HTTPS=

# --- Secreto de sesión / fingerprint (G2) ---
# Si se omite, config.php genera uno aleatorio en el primer arranque y lo
# persiste en DATA_DIR/.session_secret (permisos 600). Definir esta variable
# es opcional pero recomendado en despliegues con múltiples instancias/réplicas
# que deban compartir el mismo secreto.
# Generar uno con: php -r "echo bin2hex(random_bytes(32));"
APP_SESSION_SECRET=

# --- Ubicación de datos sensibles, fuera del document root (G3) ---
# Por defecto: un directorio hermano del proyecto (../security-image-data).
# Debe ser escribible por el usuario del servidor web y NO debe ser accesible
# por HTTP bajo ninguna ruta del vhost.
APP_DATA_DIR=

# --- Proxies de confianza (M1/M3) ---
# Lista separada por comas de IPs O RANGOS CIDR de proxies/balanceadores que
# SÍ pueden fijar X-Forwarded-Proto / X-Forwarded-For (ej: "10.0.0.5" o
# "172.16.0.0/12"). Vacío (por defecto) = nunca se confía en esas cabeceras,
# y REMOTE_ADDR/HTTPS se usan tal cual. Definir esto SIEMPRE que la app esté
# detrás de un proxy TLS real (incluye despliegues Docker con un reverse
# proxy delante) — dejarlo vacío en ese caso causa un bucle de redirecciones
# si FORCE_HTTPS está activo, porque la app nunca vería HTTPS.
APP_TRUSTED_PROXIES=

# --- Rate limiting global (H7) ---
# Límite grueso por IP aplicado a TODOS los endpoints PHP, además de los
# límites específicos de login/upload/api ya existentes en config.php.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_WINDOW_SECONDS=300

# --- Expiración de enlaces configurable por el usuario (H11) ---
# Lista separada por comas, en segundos, de las duraciones que el usuario
# puede elegir al subir una imagen. DEFAULT_IMAGE_EXPIRATION_SECONDS (fijo en
# config.php, actualmente 7 días) sigue siendo el valor por defecto si el
# usuario no elige ninguno, o si envía un valor que no está en esta lista.
APP_ALLOWED_LINK_EXPIRATIONS=3600,86400,604800,2592000,31536000

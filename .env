# .env — Security Image (PRODUCCIÓN)
#
# Este archivo contiene un secreto real (APP_SESSION_SECRET). NO debe
# subirse a git (ya está en .gitignore) ni compartirse fuera del servidor
# de producción.
#
# En Docker/docker-compose, colócalo junto al docker-compose.yml y
# referencia sus variables en el servicio PHP con `env_file: .env` o
# `environment:` + interpolación ${VAR}. Revisa .env.example para el
# detalle de cada variable.

APP_ENV=production

# Se deriva automáticamente de APP_ENV=production (FORCE_HTTPS=true).
# Déjalo vacío salvo que necesites forzar lo contrario en este despliegue.
APP_FORCE_HTTPS=

# Generado con: openssl rand -hex 32
# Si se omite, config.php genera uno aleatorio en el primer arranque, pero
# eso NO sirve si vas a correr más de un contenedor/réplica: cada uno
# generaría el suyo y las sesiones/fingerprints no coincidirían entre
# instancias. Fíjalo aquí para que todas las réplicas compartan el mismo.
APP_SESSION_SECRET=8d30f73185fcf58309261c2b73b1f6e043215a3b15b6c718ee7692e6340ba58c

# Debe apuntar a un volumen persistente FUERA de cualquier ruta servida por
# el DocumentRoot del contenedor (ver G3 en config.php). Coincide con el
# volumen montado en docker-compose.yml (security_image_data).
APP_DATA_DIR=/var/lib/security-image-data

# OBLIGATORIO en este despliegue — NO dejar vacío. Hay un proxy compartido
# delante (portal-sd.securitydata.net.ec) que termina TLS y reenvía por HTTP
# a este contenedor. Si esta lista queda vacía, isSecureConnection() nunca
# ve HTTPS y FORCE_HTTPS entra en bucle infinito de redirecciones 301 — el
# sitio no cargará.
#
# Acepta IPs exactas o rangos CIDR separados por coma (config.php ya sabe
# interpretar ambos). Se deja 172.16.0.0/12 — cubre TODAS las subredes de
# puentes Docker por defecto (172.17.0.0/16–172.31.0.0/16) — como valor
# funcional desde ya, sin que tengas que inspeccionar nada primero. Es
# razonable aquí porque este contenedor NO publica ningún puerto al host
# (ver docker-compose.yml: no hay "ports:"), así que solo otros contenedores
# de la misma red Docker pueden alcanzarlo — nunca internet directamente.
#
# Para endurecerlo más (recomendado cuando tengas tiempo): reemplázalo por
# la subred exacta de tu red compartida, con:
#   docker network inspect portal_proxy --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
APP_TRUSTED_PROXIES=172.16.0.0/12

RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_WINDOW_SECONDS=300

APP_ALLOWED_LINK_EXPIRATIONS=3600,86400,604800,2592000,31536000
